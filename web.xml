<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <servlet>
    <servlet-name>SignInServlet</servlet-name>
    <servlet-class>com.medicalapp.SignInServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SignInServlet</servlet-name>
    <url-pattern>/signin</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>DiagnosisServlet</servlet-name>
    <servlet-class>com.medicalapp.DiagnosisServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DiagnosisServlet</servlet-name>
    <url-pattern>/diagnosis</url-pattern>
  </servlet-mapping>
</web-app>
